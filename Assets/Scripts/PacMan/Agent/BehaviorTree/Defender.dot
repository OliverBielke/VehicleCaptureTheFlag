digraph Defender {
    rankdir=TB;
    splines=polyline;
    nodesep=0.45;
    ranksep=0.75;
    bgcolor="white";

    node [
        shape=box,
        style="rounded,filled",
        fontname="Arial",
        fontsize=14,
        margin="0.15,0.08",
        color="#444444",
        penwidth=1.2
    ];

    edge [
        color="#333333",
        penwidth=1.2,
        arrowsize=0.8
    ];

    Root [label="Selector (?)\nDefender", fillcolor="#FFD966"];

    S1 [label="Sequence (→)", fillcolor="#FFE599"];
    C1 [label="enemyPacmanIntruderSuspected", fillcolor="#D9D9D9"];
    A1 [label="InterceptIntruder\n[Running]", fillcolor="#9FC5E8"];

    S2 [label="Sequence (→)", fillcolor="#FFE599"];
    C2 [label="enemyLikelyCrossingMyLane", fillcolor="#D9D9D9"];
    A2 [label="BlockCrossing\n[Running]", fillcolor="#9FC5E8"];

    S3 [label="Sequence (→)", fillcolor="#FFE599"];
    C3 [label="safeMiddlePillsAvailable", fillcolor="#D9D9D9"];
    A3 [label="CollectSafeMiddlePills\n[Running]", fillcolor="#9FC5E8"];

    S4 [label="Sequence (→)", fillcolor="#FFE599"];
    C4 [label="outsideDefensiveZone", fillcolor="#D9D9D9"];
    A4 [label="MoveToFormation\n[Running]", fillcolor="#9FC5E8"];

    A5 [label="HoldDropZone\n[Running]", fillcolor="#9FC5E8"];

    Root -> S1;
    Root -> S2;
    Root -> S3;
    Root -> S4;
    Root -> A5;

    S1 -> C1;
    S1 -> A1;

    S2 -> C2;
    S2 -> A2;

    S3 -> C3;
    S3 -> A3;

    S4 -> C4;
    S4 -> A4;
}